# Copy to .env and fill in. .env is ignored by git; never commit real values.
# Login with Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fill an empty Plant Library with the 60 starter plants after `migrate` (for a server without a shell). Off by default.
SEED_PLANTS_ON_MIGRATE=False

# "Lupa password" emails. Leave EMAIL_HOST empty in development: the email is printed in the terminal instead.
# Gmail needs 2-step verification and an app password (https://myaccount.google.com/apppasswords).
EMAIL_HOST=
EMAIL_PORT=587
# if port 587 is blocked: EMAIL_PORT=465 and EMAIL_USE_SSL=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
